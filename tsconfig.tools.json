{
  // Second TS project: covers everything tsconfig.json deliberately excludes
  // (scripts/, test/, e2e/, playwright.config.ts). Until this existed,
  // `npm run typecheck` had never checked a single test file.
  //
  // Compiler options are inherited from tsconfig.json unchanged - `strict` stays
  // on. The two overrides below are corrections, not relaxations:
  //
  //  - allowImportingTsExtensions: these files are run by tsx/node with type
  //    stripping and legitimately import "./foo.ts". The project never emits,
  //    which is exactly the condition the flag exists for.
  //  - next-env.d.ts is intentionally NOT included (unlike tsconfig.json).
  //    It pulls in Next's ambient `NodeJS.ProcessEnv` augmentation, which makes
  //    NODE_ENV a *required* property. That is right for app code and wrong for
  //    scripts/tests that legitimately build partial env objects.
  //
  // There is no quarantine list any more: every file under scripts/, test/ and
  // e2e/ is type-checked, and nothing is suppressed at the config level. The
  // ratchet it used to be reached zero, so keep it there - a new exclusion is a
  // regression, not a shortcut.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./tsconfig.tools.tsbuildinfo",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // TypeScript 6 no longer auto-discovers @types/* packages; `types`
    // now defaults to []. These files are Node programs (scripts/, test/,
    // e2e/), so the node globals have to be requested by name.
    "types": ["node"]
  },
  "include": [
    "src/**/*.d.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
