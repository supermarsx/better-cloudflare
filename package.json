{
  "name": "better-cloudflare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "tauri": "node scripts/tauri-cli.mjs",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "lint": "npm run lint:app && npm run lint:src:baseline",
    "lint:app": "eslint app --rule react-refresh/only-export-components:off",
    "lint:src:baseline": "cross-env ESLINT_SRC_BASELINE=true eslint src --rule react-refresh/only-export-components:off",
    "lint:fix": "npm run lint:app -- --fix && npm run lint:src:baseline -- --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format": "npm run format:fix",
    "preview": "node test/ci-static-export-server.mjs",
    "serve:e2e:ci": "node test/ci-static-export-server.mjs",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=1536 tsx scripts/run-tests-seq.ts",
    "test:runner-contract": "tsx --test scripts/run-tests-seq.contract.test.ts",
    "test:ci-contract": "tsx --test test/ci-reliability-workflow.contract.ts",
    "test:release-contract": "node --test .github/scripts/release-contract.test.mjs",
    "test:resource-safety": "tsx --test --import ./test/node-test-env.ts test/resource-disposal.test.tsx test/AuditLogDialog.test.tsx",
    "test:unit": "npm run test",
    "test:all": "npm run test && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:reliability": "playwright test e2e/home.spec.ts e2e/login-key-management.spec.ts e2e/auth-errors.spec.ts test/ci-playwright-runtime.spec.ts --project=chromium",
    "memory:smoke:manual": "node --expose-gc --import tsx scripts/memory-growth-smoke.mjs",
    "typecheck": "npm run typecheck:app && npm run typecheck:tools",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "build:web": "npm run build",
    "build:desktop": "npm run build && npm run tauri:build",
    "clean": "node -e \"const fs=require('fs');const path=require('path');const rm=(p)=>fs.rmSync(p,{recursive:true,force:true});rm(path.join(process.cwd(),'dist'));\"",
    "clean:unix": "rm -rf ./dist && find ./src -name '*.js' -delete",
    "clean:win": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force ./dist; Get-ChildItem -Recurse -Filter *.js ./src | Remove-Item -Force\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:ci-contract",
    "ci": "npm run check",
    "deps:manifest": "tsx ./scripts/generate-dependency-manifest.ts",
    "clean:src": "tsx ./scripts/cleanup-src-js.ts",
    "check-spf": "tsx ./scripts/check-spf.ts",
    "dns": "tsx ./scripts/cli/dns-cli.ts",
    "screenshots": "tsx ./scripts/capture-screenshots.ts",
    "docs": "typedoc"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-toast": "^1.2.24",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-shell": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "cloudflare": "7.3.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "idb": "^8.0.4",
    "lucide-react": "^1.53.0",
    "mermaid": "12.1.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "sql.js": "^1.14.2",
    "sqlite3": "6.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "cross-env": "^10.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.13.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "browserslist": [
    "defaults",
    "safari >= 16"
  ],
  "dependencyNotes": {
    "overrides.mermaid.katex": "Still load-bearing, and scoped under mermaid on purpose. mermaid 12.1.0 declares katex ^0.16.47, which resolves to 0.16.47 - inside GHSA-238p-pmpm-9mq7 (prototype pollution bypassing trust restrictions, affects 0.11.0 - 0.18.1, no fix in the 0.16 line). Keeping it scoped rather than flat means it cannot silently apply to some future direct dependant that does render maths. Remove it once mermaid declares katex >=0.18.2, not before. The typescript hold is recorded and enforced in test/typescriptHold.contract.test.ts instead, where it can fail when it stops being true."
  },
  "overrides": {
    "mermaid": {
      "katex": "0.19.0"
    },
    "postcss": "$postcss"
  }
}
