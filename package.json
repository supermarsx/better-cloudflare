{
  "name": "better-cloudflare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build --webpack",
    "build:pages:ci": "cross-env GITHUB_PAGES_BASE_PATH=better-cloudflare npm run build",
    "start": "next start",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "npm run lint:app && npm run lint:src:baseline",
    "lint:app": "eslint app --rule react-refresh/only-export-components:off",
    "lint:src:baseline": "cross-env ESLINT_SRC_BASELINE=true eslint src --rule react-refresh/only-export-components:off",
    "lint:fix": "npm run lint:app -- --fix && npm run lint:src:baseline -- --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format": "npm run format:fix",
    "preview": "npx serve out",
    "serve:e2e:ci": "node test/ci-static-export-server.mjs",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=1536 tsx scripts/run-tests-seq.ts",
    "test:runner-contract": "tsx --test scripts/run-tests-seq.contract.test.ts",
    "test:ci-contract": "tsx --test test/ci-reliability-workflow.contract.ts",
    "test:release-contract": "node --test .github/scripts/release-contract.test.mjs",
    "test:resource-safety": "tsx --test --import ./test/node-test-env.ts test/resource-disposal.test.tsx test/AuditLogDialog.test.tsx",
    "test:unit": "npm run test",
    "test:all": "npm run test && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:reliability": "playwright test e2e/home.spec.ts e2e/login-key-management.spec.ts e2e/auth-errors.spec.ts test/ci-playwright-runtime.spec.ts --project=chromium",
    "test:e2e:pages": "cross-env CI=true PLAYWRIGHT_STATIC_BASE_PATH=/better-cloudflare playwright test test/ci-pages-base-path.spec.ts --project=chromium",
    "memory:smoke:manual": "node --expose-gc --import tsx scripts/memory-growth-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "npm run build",
    "build:desktop": "npm run build && npm run tauri:build",
    "clean": "node -e \"const fs=require('fs');const path=require('path');const rm=(p)=>fs.rmSync(p,{recursive:true,force:true});rm(path.join(process.cwd(),'dist'));\"",
    "clean:unix": "rm -rf ./dist && find ./src -name '*.js' -delete",
    "clean:win": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force ./dist; Get-ChildItem -Recurse -Filter *.js ./src | Remove-Item -Force\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:ci-contract",
    "ci": "npm run check",
    "clean:src": "tsx ./scripts/cleanup-src-js.ts",
    "check-spf": "tsx ./scripts/check-spf.ts",
    "docs": "typedoc"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "cloudflare": "7.0.0",
    "clsx": "^2.1.1",
    "i18next": "^23.0.1",
    "idb": "^7.1.1",
    "lucide-react": "^0.525.0",
    "mermaid": "11.16.0",
    "next": "16.2.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^14.0.1",
    "sql.js": "^1.8.0",
    "sqlite3": "6.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@simplewebauthn/browser": "^6.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.7.0",
    "cross-env": "^7.0.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "^16.3.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.25",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.2.0",
    "react-window": "^1.8.7",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.3",
    "turbo": "2.10.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.3"
    },
    "postcss": "8.5.25"
  }
}
